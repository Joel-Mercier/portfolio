---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LinkButton from "../../components/LinkButton.astro";
import BackLink from "../../components/BackLink.astro";
import ArrowUpRight from "../../components/icons/ArrowUpRight.astro";
import { getWorks, type Work } from "../../lib/works";
import { t } from "../../i18n";

interface Props {
  work: Work;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const works = await getWorks();
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
};

const { work } = Astro.props;
const { Content } = await render(work);

const arrowClass =
  "ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none";
---

<BaseLayout title={work.data.title} description={work.data.lead}>
  <div class="lg:py-24">
    <BackLink fallbackHref="/works" label={t("works.back")} />
    <h1
      class="mb-12 text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl"
      transition:name={`work-${work.id}`}
    >
      {work.data.title}
    </h1>
    <div class="flex flex-col-reverse lg:flex-row">
      <div
        class="prose text-slate-200 prose-headings:text-slate-200 prose-h2:font-semibold prose-h3:font-semibold prose-h4:font-semibold prose-h5:font-semibold prose-h6:font-semibold prose-p:mb-4 prose-a:font-medium prose-a:text-slate-200 hover:prose-a:text-red-300 focus-visible:prose-a:text-red-300 prose-strong:text-slate-200 prose-img:rounded-md"
      >
        {
          work.data.video && (
            <iframe
              class="aspect-video w-full"
              src={`https://www.youtube.com/embed/${work.data.video}`}
              title={t("a11y.videoTitle", { title: work.data.title })}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            />
          )
        }
        <Content />
      </div>
      <div class="mb-8 flex w-full flex-col lg:mb-0 lg:items-end">
        {
          work.data.url && (
            <LinkButton href={work.data.url} external class="text-lg font-bold">
              {t("works.viewProject")}
              <span class="inline-block">
                <ArrowUpRight class={arrowClass} />
              </span>
            </LinkButton>
          )
        }
        {
          work.data.code && (
            <LinkButton href={work.data.code} external class="text-lg font-bold">
              {t("works.viewCode")}
              <span class="inline-block">
                <ArrowUpRight class={arrowClass} />
              </span>
            </LinkButton>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
