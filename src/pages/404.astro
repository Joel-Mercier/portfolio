---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArrowLeft from "../components/icons/ArrowLeft.astro";
import { t } from "../i18n";
---

<BaseLayout title={t("notFound.title")} description={t("notFound.lead")}>
  <div class="flex min-h-screen flex-col justify-center lg:py-24">
    <p class="text-sm font-bold uppercase tracking-widest text-red-500">
      {t("notFound.heading")}
    </p>
    <h1
      class="mt-3 text-4xl font-bold tracking-tight text-slate-200 sm:text-5xl"
    >
      {t("notFound.title")}
    </h1>
    <p class="mt-4 max-w-md leading-normal">{t("notFound.lead")}</p>
    <a
      href="/"
      class="group mt-8 inline-flex w-max items-center font-semibold leading-tight text-red-500"
    >
      <ArrowLeft
        class="mr-1 h-4 w-4 transition-transform group-hover:-translate-x-2 motion-reduce:transition-none"
      />
      {t("notFound.back")}
    </a>
  </div>
</BaseLayout>
