---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import Mask from "../components/Mask.astro";
import { t, defaultLocale } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = t("site.description") } = Astro.props;
const pageTitle = title
  ? t("site.titleTemplate", { title })
  : t("site.title");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body
    class="bg-slate-900 font-sans leading-relaxed text-slate-400 antialiased selection:bg-emerald-100 selection:text-emerald-900"
  >
    <div class="relative">
      <Mask />
      <main
        class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
