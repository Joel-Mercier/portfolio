---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={[
    "inline-flex items-center rounded-full border border-transparent bg-red-400/10 px-2.5 py-0.5 text-xs font-semibold text-red-300 transition-colors",
    className,
  ]}
>
  <slot />
</div>
