---
import OpenSourceProject from "./OpenSourceProject.astro";
import { getOpenSourceProjects } from "../lib/opensource";

const projects = await getOpenSourceProjects();
---

<ol class="group/list">
  {
    projects.map((project) => (
      <li class="mb-16">
        <OpenSourceProject project={project} />
      </li>
    ))
  }
</ol>
