---
import ArrowLeft from "./icons/ArrowLeft.astro";

interface Props {
  fallbackHref: string;
  label: string;
  class?: string;
}
const { fallbackHref, label, class: className } = Astro.props;
---

<a
  href={fallbackHref}
  data-back-link
  class:list={[
    "group mb-2 inline-flex items-center font-semibold leading-tight text-red-500",
    className,
  ]}
>
  <ArrowLeft
    class="mr-1 h-4 w-4 transition-transform group-hover:-translate-x-2 motion-reduce:transition-none"
  />
  {label}
</a>

<script>
  function initBackLink() {
    const link = document.querySelector<HTMLAnchorElement>("[data-back-link]");
    if (!link) return;

    link.addEventListener("click", (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) {
        return;
      }

      const index = (history.state as { index?: number } | null)?.index ?? 0;
      if (index === 0) return;

      event.preventDefault();
      history.back();
    });
  }

  document.addEventListener("astro:page-load", initBackLink);
</script>
