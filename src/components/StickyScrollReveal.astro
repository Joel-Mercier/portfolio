---
import { Image } from "astro:assets";
import type { Work } from "../lib/works";

interface Props {
  works: Work[];
}
const { works } = Astro.props;

const gradients = [
  "linear-gradient(to bottom right, var(--color-cyan-500), var(--color-emerald-500))",
  "linear-gradient(to bottom right, var(--color-pink-500), var(--color-indigo-500))",
  "linear-gradient(to bottom right, var(--color-orange-500), var(--color-yellow-500))",
];
---

<div class="flex justify-between space-x-10 rounded-md" data-sticky-scroll>
  <div class="flex items-start px-4">
    <div class="max-w-2xl">
      {
        works.map((work, index) => (
          <a
            href={`/works/${work.id}`}
            class="group my-20 block cursor-pointer"
            data-card
            data-index={index}
          >
            <h2
              class="text-2xl font-bold text-slate-100 opacity-40 transition-opacity duration-300 group-hover:opacity-100"
              data-card-title
              transition:name={`work-${work.id}`}
            >
              {work.data.title}
            </h2>
            <p
              class="mt-10 max-w-sm opacity-30 transition-opacity duration-300 group-hover:opacity-100"
              data-card-lead
            >
              {work.data.lead}
            </p>
          </a>
        ))
      }
      <div class="h-40"></div>
    </div>
  </div>
  <div
    class="sticky top-1/2 hidden h-96 w-96 -translate-y-1/2 overflow-hidden rounded-md bg-white transition-[background] duration-300 lg:block"
    style={`background: ${gradients[0]}`}
    data-panel
    data-gradients={JSON.stringify(gradients)}
  >
    {
      works.map((work, index) => (
        <Image
          src={work.data.cover}
          alt={work.data.title}
          layout="none"
          widths={[384, 768]}
          sizes="384px"
          loading="eager"
          fetchpriority={index === 0 ? "high" : "low"}
          class="absolute inset-0 h-full w-full object-cover transition-opacity duration-300"
          style={`opacity: ${index === 0 ? 1 : 0}`}
          data-panel-image
          data-index={index}
        />
      ))
    }
  </div>
</div>

<script>
  function initStickyScroll() {
    const container = document.querySelector<HTMLElement>("[data-sticky-scroll]");
    if (!container) return;

    const cards = Array.from(
      container.querySelectorAll<HTMLAnchorElement>("[data-card]"),
    );
    const panel = container.querySelector<HTMLElement>("[data-panel]");
    const images = Array.from(
      container.querySelectorAll<HTMLElement>("[data-panel-image]"),
    );
    if (cards.length === 0 || !panel) return;

    const gradients: string[] = JSON.parse(panel.dataset.gradients ?? "[]");
    let active = -1;

    const setActive = (index: number) => {
      if (index === active) return;
      active = index;

      cards.forEach((card, i) => {
        const isActive = i === index;
        card
          .querySelector<HTMLElement>("[data-card-title]")
          ?.style.setProperty("opacity", isActive ? "1" : "0.4");
        card
          .querySelector<HTMLElement>("[data-card-lead]")
          ?.style.setProperty("opacity", isActive ? "1" : "0.3");
      });

      images.forEach((image, i) =>
        image.style.setProperty("opacity", i === index ? "1" : "0"),
      );

      if (gradients.length > 0) {
        panel.style.background = gradients[index % gradients.length];
      }
    };

    // Nearest card boundary to the container's scroll progress.
    const nearestCard = (progress: number) => {
      let closest = 0;
      cards.forEach((_, index) => {
        const breakpoint = index / cards.length;
        if (
          Math.abs(progress - breakpoint) <
          Math.abs(progress - closest / cards.length)
        ) {
          closest = index;
        }
      });
      return closest;
    };

    let frame = 0;
    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = container.getBoundingClientRect();
        const scrollable = rect.height - window.innerHeight;
        const progress =
          scrollable <= 0 ? 0 : Math.min(Math.max(-rect.top / scrollable, 0), 1);
        setActive(nearestCard(progress));
      });
    };

    cards.forEach((card, index) =>
      card.addEventListener("mouseover", () => setActive(index)),
    );

    setActive(0);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    onScroll();

    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        cancelAnimationFrame(frame);
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initStickyScroll);
</script>
