---
interface Props {
  title: string;
  /** Section number shown before the title, e.g. "01" */
  index: string;
}
const { title, index } = Astro.props;
---

<div
  class="sticky top-0 z-20 -mx-6 mb-6 w-screen px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:static lg:mx-0 lg:mb-12 lg:w-full lg:px-0 lg:py-0 lg:backdrop-blur-none"
>
  <h2
    class="flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-slate-200 lg:gap-4 lg:text-2xl lg:normal-case lg:tracking-tight"
  >
    <span
      class="font-mono text-xs font-medium tracking-normal text-red-400 lg:text-sm"
      aria-hidden="true">{index}</span
    >
    <span>{title}</span>
    <span
      class="h-px flex-1 bg-linear-to-r from-slate-600 to-transparent"
      aria-hidden="true"></span>
  </h2>
</div>
